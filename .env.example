# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# YouTube Data API v3 Key
# Get yours at: https://console.cloud.google.com/
# Enable "YouTube Data API v3" in your project
YOUTUBE_API_KEY=
